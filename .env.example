# --- Supabase Configuration ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
SUPABASE_PROJECT_ID=your_project_id

# Client-side bundle exposed variables (Vite prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
VITE_SUPABASE_PROJECT_ID=your_project_id

# Server-only Admin key (Optional: used for admin operations & signed media assets)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Third-party Integrations ---
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...your_google_maps_api_key

# --- Site URL (Used for production sitemap.xml & canonical URLs) ---
SITE_URL=https://infeworks.com
